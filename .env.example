# --- Database ---
# Postgres connection string. Use a managed provider (Supabase, Neon, RDS) in prod.
DATABASE_URL="postgresql://user:password@localhost:5432/clutchrank"

# --- Stripe ---
# From the Stripe dashboard (test mode keys start with sk_test_ / pk_test_)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen` locally, or the webhook endpoint config in prod
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- App ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Security ---
# Random 32+ char string used to hash edit tokens and IPs (HMAC key).
# Generate with: openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string"

# Admin panel password (moderation dashboard). Use a strong, unique value.
ADMIN_PASSWORD="change-me"

# --- Rate limiting (optional but strongly recommended in prod) ---
# If unset, falls back to an in-memory limiter that only works on a single
# server instance - fine for a demo, NOT fine once you scale past one dyno.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
